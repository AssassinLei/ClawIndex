# Copy to .env.cloud on the server. Credentials remain outside the image/repository.
TUSHARE_TOKEN=
VNEXT_LLM_API_KEY=
VNEXT_LLM_BASE_URL=https://api.deepseek.com
VNEXT_LLM_MODEL=deepseek-chat
VNEXT_LLM_TIMEOUT_SECONDS=60
VNEXT_LLM_MAX_TOKENS=1800
VNEXT_LLM_THINKING=disabled
# Port defaults to loopback; use SSH tunnel or existing private reverse proxy.
CLAWINDEX_BIND_ADDRESS=127.0.0.1
CLAWINDEX_PORT=8502
