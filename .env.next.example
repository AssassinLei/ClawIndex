# Copy to .env.next. Keep credentials outside Git. The legacy .env is not loaded.
VNEXT_DB_PATH=quant_system_next.db
TUSHARE_TOKEN=
# Optional AI explanation: deterministic decisions do not require this key.
VNEXT_LLM_API_KEY=
VNEXT_LLM_BASE_URL=https://api.deepseek.com
VNEXT_LLM_MODEL=deepseek-chat
# AI request timeout 5-60 seconds. DeepSeek explanations use non-thinking mode.
VNEXT_LLM_TIMEOUT_SECONDS=60
VNEXT_LLM_MAX_TOKENS=1800
VNEXT_LLM_THINKING=disabled
